#!/usr/bin/env rexx
/* Socket: connecting, the stream methods, errors and timeouts.
   Each test runs the other end in another activity (peer.cls).          */

  parse source . . fileSpec
  group = .TestGroup~new(fileSpec)
  group~add(.Socket.testGroup)
  if group~isAutomatedTest then return group
  testResult = group~suite~execute~~print
return testResult

::requires 'ooTest.frm'
::requires 'sockets.cls'
::requires 'peer.cls'

::class "Socket.testGroup" subclass ooTestCase public

/* ---- the samples -------------------------------------------------------- */

::method test_client_and_server
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("echo")
    s = .Socket~new("127.0.0.1", peer~port)
    s~lineOut("Hello, this is from your ooRexx-client!")
    self~assertSame("Hello, this is from your ooRexx-client!", s~lineIn)
    s~lineOut("bye")
    s~close
    got = msg~result
    self~assertSame(2, got~items)
    self~assertSame("bye", got[2])
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_localhost_by_name
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("echo")
    s = .Socket~new("localhost", peer~port)
    s~lineOut("bye")
    s~close
    self~assertSame("bye", msg~result[1])
  finally
    if s \== .nil then s~close
    peer~close
  end

/* ---- lines -------------------------------------------------------------- */

::method test_lineIn_takes_lf_and_crlf_and_a_last_line_without_end
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("send", "one" || "0a"x || "two" || "0d0a"x || "0a"x || "three")
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertSame("one", s~lineIn)
    self~assertSame("two", s~lineIn)
    self~assertSame("", s~lineIn)
    self~assertSame("three", s~lineIn)
    self~assertSame("READY", s~state)
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_end_of_stream_is_notready
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("send", "last" || "0a"x)
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertSame("last", s~lineIn)
    c = .nil
    do
      line = s~lineIn
    catch c = notready
    end
    self~assertTrue(c \== .nil, "NOTREADY at the end of the stream")
    self~assertSame(s, c~additional)
    self~assertSame(s~string, c~description)
    self~assertSame("NOTREADY", s~state)
    self~assertSame("NOTREADY:EOF", s~description)
    self~assertSame(0, s~lines)
    self~assertSame(0, s~chars)
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_end_of_stream_untrapped_returns_empty
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("acceptAndClose")
    s = .Socket~new("127.0.0.1", peer~port)
    msg~result
    self~assertSame("", s~lineIn)
    self~assertSame("NOTREADY", s~state)
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_lineOut_writes_crlf
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect")
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertSame(0, s~lineOut("a"))
    s~close
    self~assertSame("610D0A", msg~result~c2x)
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_lineEnd_can_change
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect")
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertSame("0D0A", s~lineEnd~c2x)
    s~lineEnd = "0a"x
    s~lineOut("a")
    s~close
    self~assertSame("610A", msg~result~c2x)
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_lines_and_chars_before_data
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("silentThenLine", 0.3, "late")
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertSame(1, s~lines)          -- nothing yet, but the connection is open
    self~assertSame(1, s~chars)
    self~assertSame("late", s~lineIn)
    s~close
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

/* ---- bytes -------------------------------------------------------------- */

::method test_every_byte_goes_through
  bytes = xrange("00"x, "ff"x)
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect", bytes)
    s = .Socket~new("127.0.0.1", peer~port)
    s~charOut(bytes)
    s~shutdownOutput
    self~assertSame(bytes~c2x, s~charIn(, 256)~c2x)
    s~close
    self~assertSame(bytes~c2x, msg~result~c2x)
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_a_megabyte_each_way
  data = copies(xrange("00"x, "ff"x), 4096)      -- 1 MiB
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect", data)
    s = .Socket~new("127.0.0.1", peer~port)
    s~charOut(data)
    s~shutdownOutput
    back = s~charIn(, data~length)
    self~assertSame(data~length, back~length)
    self~assertTrue(back == data)
    self~assertTrue(msg~result == data)
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_read_returns_what_has_arrived
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("send", "abc")
    s = .Socket~new("127.0.0.1", peer~port)
    msg~result
    self~assertSame("ab", s~read(2))
    self~assertSame("c", s~read)
    self~assertSame("", s~read)
    self~assertSame("NOTREADY:EOF", s~description)
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_charIn_short_at_the_end
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("send", "xyz")
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertSame("xyz", s~charIn(, 10))
    self~assertSame("NOTREADY", s~state)
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

/* ---- as a stream -------------------------------------------------------- */

::method test_is_a_stream
  self~assertTrue(.Socket~isSubclassOf(.InputOutputStream))

::method test_say_to_the_network
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect")
    s = .Socket~new("127.0.0.1", peer~port)
    .output~destination(s)
    do
      say "through .output"
    finally
      .output~destination                    -- back, whatever happened
    end
    s~close
    self~assertSame("through .output" || "0d0a"x, msg~result)
  finally
    if s \== .nil then s~close
    peer~close
  end

-- As it was, without FINALLY: the label a SIGNAL ON goes to cannot be
-- inside a block, and a FINALLY clause would run before what follows it.
::method test_a_server_loop_with_signal_on_notready
  peer = .Peer~new
  msg = peer~start("send", "a" || "0a"x || "b" || "0a"x || "c" || "0a"x)
  s = .Socket~new("127.0.0.1", peer~port)
  got = ""
  signal on notready name done
  loop
    got = got || s~lineIn
  end
done:
  self~assertSame("abc", got)
  msg~result
  s~close
  peer~close

::method test_a_server_loop_with_catch_notready
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("send", "a" || "0a"x || "b" || "0a"x || "c" || "0a"x)
    s = .Socket~new("127.0.0.1", peer~port)
    got = ""
    loop
      got = got || s~lineIn
    catch notready
    end
    self~assertSame("abc", got)
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

-- The README's "A protocol in a class of its own: THROW": MailServer below
-- is the README's. Each test runs the README's program, outcome for its say.
::method test_throw_propagate_takes_notready_to_the_program
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("send", "220 ready" || "0d0a"x)   -- greets, then goes away
    s = .Socket~new("127.0.0.1", peer~port)
    s~readTimeout = 10
    outcome = mailCheck(.MailServer~new(s))
    self~assertSame("lost the connection", outcome)
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_throw_user_protocol_says_what_went_wrong
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("dialogue", "220 ready", "500 what?")
    s = .Socket~new("127.0.0.1", peer~port)
    s~readTimeout = 10
    outcome = mailCheck(.MailServer~new(s))
    self~assertSame("unexpected reply: expected 221; got 500 what?", outcome)
    s~close
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_the_protocol_s_reply_is_221
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("dialogue", "220 ready", "221 bye")
    s = .Socket~new("127.0.0.1", peer~port)
    s~readTimeout = 10
    self~assertSame("the server answers", mailCheck(.MailServer~new(s)))
    s~close
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

-- What the README says happens without the CATCH clause in ask: the
-- NOTREADY stays in ask, reply is empty, and the program hears only that
-- the reply was not 221.
::method test_without_throw_the_notready_is_lost_in_the_method
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("send", "220 ready" || "0d0a"x)
    s = .Socket~new("127.0.0.1", peer~port)
    s~readTimeout = 10
    outcome = mailCheck(.MailServerWithoutCatch~new(s))
    self~assertSame("unexpected reply: expected 221; got", outcome~strip)
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_shutdownOutput_then_read_the_reply
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect", "the reply")
    s = .Socket~new("127.0.0.1", peer~port)
    s~charOut("the request")
    self~assertSame(0, s~shutdownOutput)
    self~assertSame("the reply", s~lineIn)
    self~assertSame("the request", msg~result)
  finally
    if s \== .nil then s~close
    peer~close
  end

/* ---- activities --------------------------------------------------------- */

-- One activity blocked reading, another writing on the same socket.
::method test_read_and_write_from_two_activities
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("echo")
    s = .Socket~new("127.0.0.1", peer~port)
    reader = .Reader~new~start("lines", s, 3)
    call sysSleep 0.2                          -- the reader is now in lineIn
    s~lineOut("one"); s~lineOut("two"); s~lineOut("three")
    got = reader~result
    self~assertSame("one two three", got~makeString("L", " "))
    s~lineOut("bye")
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

-- close, from another activity, wakes a read that waits.
::method test_close_wakes_a_blocked_read
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("silentThenLine", 3, "too late")
    s = .Socket~new("127.0.0.1", peer~port)
    reader = .Reader~new~start("lines", s, 1)
    call sysSleep 0.2
    t0 = .dateTime~new
    s~close
    got = reader~result
    waited = (.dateTime~new - t0)~totalSeconds
    self~assertTrue(waited < 2, "the read woke up when the socket was closed (" || waited || "s)")
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

/* ---- addresses ---------------------------------------------------------- */

::method test_addresses
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("echo")
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertSame("127.0.0.1", s~remoteAddress)
    self~assertSame(peer~port, s~remotePort)
    self~assertSame("127.0.0.1", s~localAddress)
    self~assertTrue(s~localPort > 0)
    self~assertSame("127.0.0.1:" || peer~port, s~string)
    s~lineOut("bye")
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_resolve_localhost
  addrs = .Socket~resolve("localhost")
  self~assertTrue(addrs~isA(.Array))
  self~assertTrue(addrs~items > 0)
  self~assertTrue(addrs~hasItem("127.0.0.1") | addrs~hasItem("::1"))

::method test_resolve_a_literal
  self~assertSame("192.0.2.1", .Socket~resolve("192.0.2.1")[1])

::method test_resolve_unknown_host
  self~expectSyntax(48.900)
  .Socket~resolve("no-such-host.invalid")

/* ---- errors ------------------------------------------------------------- */

::method test_refused_is_syntax_48_900
  port = freePort()
  self~expectSyntax(.array~of(48.900, "Socket error: connection refused (127.0.0.1, port" port")"))
  s = .Socket~new("127.0.0.1", port)

::method test_refused_carries_the_system_error
  port = freePort()
  c = .nil
  do
    s = .Socket~new("127.0.0.1", port)
  catch c = syntax
  end
  if c == .nil then self~fail("connected to a closed port")
  self~assertSame(48, c~rc)
  self~assertSame("ECONNREFUSED", c~additional[2])
  self~assertTrue(c~additional[4] \== "", "the system's text")   -- e.g. "Connection refused"
  self~assertSame("SOCKET", c~additional[5])

::method test_unknown_host
  self~expectSyntax(.array~of(48.900, "Socket error: unknown host (no-such-host.invalid, port 80)"))
  s = .Socket~new("no-such-host.invalid", 80)

::method test_bad_port
  self~expectSyntax(88.900)
  s = .Socket~new("127.0.0.1", 70000)

::method test_bad_timeout
  self~expectSyntax(88.900)
  s = .Socket~new("127.0.0.1", 80, -1)

::method test_after_close_reads_are_notready
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("echo")
    s = .Socket~new("127.0.0.1", peer~port)
    s~close
    self~assertSame("UNKNOWN", s~state)
    self~assertSame("", s~lineIn)
    self~assertSame(1, s~lineOut("x"))
    self~assertSame("NOTREADY:closed", s~description)
    s~close                                    -- twice: harmless
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

/* ---- timeouts ----------------------------------------------------------- */

::method test_read_timeout_is_notready_and_the_socket_stays_usable
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("silentThenLine", 0.6, "late")
    s = .Socket~new("127.0.0.1", peer~port)
    s~readTimeout = 0.1
    self~assertSame(0.1, s~readTimeout)
    self~assertSame("", s~lineIn)
    self~assertSame("NOTREADY:TIMEOUT", s~description)
    s~readTimeout = .nil
    self~assertSame("late", s~lineIn)
    self~assertSame("READY", s~state)
    s~close
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_connect_timeout_argument
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("acceptAndClose")
    s = .Socket~new("127.0.0.1", peer~port, 5)
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

/* ---- write buffering ---------------------------------------------------- */

::method test_writes_go_out_at_once_by_default
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("linesWithin", 0.5)
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertFalse(s~bufferOutput)
    s~lineOut("a")
    self~assertSame("a", msg~result~makeString("L", " "))   -- before close
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_buffered_writes_are_kept
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("linesWithin", 0.3)
    s = .Socket~new("127.0.0.1", peer~port)
    s~bufferOutput = .true
    self~assertTrue(s~bufferOutput)
    self~assertSame(0, s~lineOut("a"))
    self~assertSame(0, s~charOut("b"))
    self~assertSame(0, msg~result~items)                    -- nothing arrived
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_flush_sends_what_was_kept
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("linesWithin", 0.5)
    s = .Socket~new("127.0.0.1", peer~port)
    s~bufferOutput = .true
    s~lineOut("a"); s~lineOut("b")
    self~assertSame("READY:", s~flush)
    self~assertSame("a b", msg~result~makeString("L", " "))
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_close_sends_what_was_kept
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect")
    s = .Socket~new("127.0.0.1", peer~port)
    s~bufferOutput = .true
    s~lineOut("a")
    self~assertSame("READY:", s~close)
    self~assertSame("610D0A", msg~result~c2x)
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_a_read_that_waits_sends_what_was_kept_first
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("echo")
    s = .Socket~new("127.0.0.1", peer~port)
    s~bufferOutput = .true
    s~readTimeout = 3                          -- a failure, not a hang
    s~lineOut("ping")
    self~assertSame("ping", s~lineIn)          -- the request went out first
    s~lineOut("bye")
    s~close
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_a_full_buffer_is_sent
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("linesWithin", 0.5)
    s = .Socket~new("127.0.0.1", peer~port)
    s~bufferOutput = 10
    s~lineOut("12345678")                      -- 10 bytes with CRLF: full
    self~assertSame("12345678", msg~result~makeString("L", " "))
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_bufferOutput_false_sends_what_was_kept
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("linesWithin", 0.5)
    s = .Socket~new("127.0.0.1", peer~port)
    s~bufferOutput = .true
    s~lineOut("a")
    s~bufferOutput = .false
    self~assertFalse(s~bufferOutput)
    s~lineOut("b")                             -- at once again
    self~assertSame("a b", msg~result~makeString("L", " "))
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_shutdownOutput_sends_what_was_kept
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect", "done")
    s = .Socket~new("127.0.0.1", peer~port)
    s~bufferOutput = .true
    s~charOut("abc")
    s~shutdownOutput
    self~assertSame("done", s~read)
    s~close
    self~assertSame("abc", msg~result)
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_many_buffered_lines_arrive_in_order
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("collect")
    s = .Socket~new("127.0.0.1", peer~port)
    s~bufferOutput = 1000
    expected = .mutableBuffer~new
    do i = 1 to 5000
      s~lineOut(i)
      expected~append(i || "0d0a"x)
    end
    s~close
    self~assertTrue(expected~string == msg~result, "5000 lines, in order")
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_bad_bufferOutput
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("acceptAndClose")
    s = .Socket~new("127.0.0.1", peer~port)
    msg~result
    self~expectSyntax(88.900)
    s~bufferOutput = -5
  finally
    if s \== .nil then s~close
    peer~close
  end

::method test_noDelay
  peer = .Peer~new
  s = .nil
  do
    msg = peer~start("acceptAndClose")
    s = .Socket~new("127.0.0.1", peer~port)
    self~assertFalse(s~noDelay)
    s~noDelay = .true
    self~assertTrue(s~noDelay)
    s~noDelay = .false
    self~assertFalse(s~noDelay)
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end

/* ---- IPv6 (where the machine has it) ------------------------------------ */

::method test_ipv6_loopback
  peer = ipv6Peer()
  if peer == .nil then do                    -- no IPv6 here
    say "  (no IPv6 on this machine: test_ipv6_loopback checked nothing)"
    return
  end
  s = .nil
  do
    msg = peer~start("echo")
    s = .Socket~new("::1", peer~port)
    self~assertSame("::1", s~remoteAddress)
    self~assertSame("[::1]:" || peer~port, s~string)
    s~lineOut("bye")
    msg~result
  finally
    if s \== .nil then s~close
    peer~close
  end


-- Reads lines in its own activity.
::class Reader
::method lines
  use strict arg s, n
  got = .array~new
  do n
    got~append(s~lineIn)
  catch notready
  end
  return got

-- A port nobody listens on: one the system gave and took back.
::routine freePort
  srv = .ServerSocket~new(0, "127.0.0.1")
  port = srv~localPort
  srv~close
  return port

-- A Peer on ::1, or .nil if the machine has no IPv6.
::routine ipv6Peer
  do
    return .Peer~new("::1")
  catch syntax
    return .nil
  end

-- The README's program, "A protocol in a class of its own: THROW", with
-- what it says as the result.
::routine mailCheck
  use strict arg server
  s = server~socket
  do
    server~check
    return "the server answers"
  catch notready                              -- the connection failed, at any depth
    return "lost the connection"
  catch c = user protocol                     -- the server said something else
    return "unexpected reply:" c~description
  finally
    s~close                                   -- however it ended
  end

-- The README's MailServer (and socket, for mailCheck).
::class MailServer
::method init
  expose s; use strict arg s
::method socket
  expose s; return s
::method check
  self~ask("", "220")                       -- the greeting
  self~ask("QUIT", "221")
::method ask private                        -- sends a line (if any), reads the reply
  expose s; use strict arg line, code
  do
    if line \== "" then s~lineOut(line)
    reply = s~lineIn
  catch notready
    throw propagate                         -- on past check, to the program's CATCH
  end
  if \reply~startsWith(code) then
    throw user protocol description ("expected" code"; got" reply)
  return reply

-- The same without the CATCH clause in ask.
::class MailServerWithoutCatch subclass MailServer
::method ask private
  use strict arg line, code
  s = self~socket                           -- MailServer's: another scope
  if line \== "" then s~lineOut(line)
  reply = s~lineIn
  if \reply~startsWith(code) then
    throw user protocol description ("expected" code"; got" reply)
  return reply
