#!/usr/bin/env rexx
/* DTLSSocket and DTLSServerSocket: TLS over UDP. The clients run in
   another activity (the Client class below), trusting the test CA in
   tests/certs/. One server socket serves every client.                  */

  parse source . . fileSpec
  group = .TestGroup~new(fileSpec)
  group~add(.DTLSSocket.testGroup)
  if group~isAutomatedTest then return group
  testResult = group~suite~execute~~print
return testResult

::requires 'ooTest.frm'
::requires 'sockets.cls'
::requires 'peer.cls'

::class "DTLSSocket.testGroup" subclass ooTestCase public

/* ---- serving ------------------------------------------------------------ */

::method test_echo
  srv = newServer()
  self~assertSame("a DTLSServerSocket on port" srv~localPort, srv~string)
  msg = .Client~new~start("echoOnce", srv~localPort, "Hello, DTLS")
  c = srv~accept
  self~assertTrue(c~isA(.DTLSSocket))
  self~assertTrue(c~secure)
  self~assertSame("127.0.0.1", c~remoteAddress)
  c~receiveTimeout = 10
  d = c~receive                              -- the handshake ends here
  self~assertSame("DTLSv1.2", c~protocol)
  self~assertTrue(c~cipher \== "")
  self~assertTrue(d~isA(.Datagram))
  self~assertSame("Hello, DTLS", d~data)
  self~assertSame(c~remotePort, d~port)
  c~send(d~data~upper)
  self~assertSame("HELLO, DTLS DTLSv1.2", msg~result)
  c~close
  srv~close

::method test_the_client_side
  srv = newServer()
  msg = .Server~new~start("echoAll", srv)
  s = .DTLSSocket~new("localhost", srv~localPort, trustCA(), 10)
  self~assertSame("localhost:"srv~localPort, s~string)
  self~assertSame("127.0.0.1", s~remoteAddress)
  self~assertSame(srv~localPort, s~remotePort)
  self~assertTrue(s~localPort > 0)
  s~receiveTimeout = 10
  do i = 1 to 20
    s~send("datagram" i)
    self~assertSame("DATAGRAM" i, s~receive~data)
  end
  s~send("bye")
  self~assertSame("BYE", s~receive~data)
  s~close
  self~assertSame(21, msg~result)
  srv~close

::method test_two_clients_on_one_port
  srv = newServer()
  m1 = .Client~new~start("echoOnce", srv~localPort, "one")
  m2 = .Client~new~start("echoOnce", srv~localPort, "two")
  a = srv~accept; b = srv~accept
  self~assertTrue(a~remotePort \= b~remotePort)
  a~receiveTimeout = 10; b~receiveTimeout = 10
  -- each answers its own client: b first
  db = b~receive; b~send(db~data~upper)
  da = a~receive; a~send(da~data~upper)
  self~assertSame("ONE DTLSv1.2", m1~result)
  self~assertSame("TWO DTLSv1.2", m2~result)
  a~close; b~close
  srv~close

::method test_the_largest_datagram
  srv = newServer()
  msg = .Client~new~start("echoOnce", srv~localPort, "x"~copies(16384))
  c = srv~accept
  c~receiveTimeout = 10
  d = c~receive
  self~assertSame(16384, d~data~length)
  c~send("ok")
  self~assertSame("ok DTLSv1.2", msg~result)
  self~expectSyntax(.array~of(48.900, "TLS error: message too long (127.0.0.1, port" c~remotePort")"))
  c~send("x"~copies(16385))

::method test_a_keytool_keystore_on_both_ends
  srv = .DTLSServerSocket~new(0, .TLSOptions~new~certificate(certFile("keytool.p12"), "123456"), "127.0.0.1")
  opts = .TLSOptions~new~trust(certFile("keytool.p12"), "123456")
  msg = .Client~new~start("echoOnce", srv~localPort, "keytool", opts)
  c = srv~accept
  c~receiveTimeout = 10
  c~send(c~receive~data)
  self~assertSame("keytool DTLSv1.2", msg~result)
  c~close
  srv~close

-- accept returns a client once it has sent the cookie back; its handshake
-- ends on its first receive or send, and a failure is a SYNTAX condition
-- there (Rony, 29/10/2026: as TLSServerSocket). The server goes on.
::method test_a_failing_client_is_told_on_first_use
  srv = newServer()
  port = srv~localPort
  bad = .Client~new~start("connectOnly", port, .nil)  -- the system's trust: not the test CA
  good = .Client~new~start("echoOnce", port, "good", trustCA(), 3)  -- starts later
  c = srv~accept                             -- the bad one, its handshake not over
  c~receiveTimeout = 10
  signal on syntax name failed
  c~receive
  self~fail("the bad client's receive should have failed")
failed:
  co = condition("o")
  self~assertSame(48.900, co~code)
  self~assertTrue(co~additional[1]~startsWith("TLS error: handshake failed: "), co~additional[1])
  self~assertSame("TLS", co~additional[2])
  -- "certificate is not trusted"; macOS may first say "is valid for
  -- longer than the system allows" (the test CA's hundred years)
  r = bad~result
  self~assertTrue(r~startsWith("TLS error: certificate "), r)
  self~assertTrue(r~endsWith("(localhost, port" port")"), r)
  c~close
  c = srv~accept                             -- the next one is served
  c~receiveTimeout = 10
  c~send(c~receive~data)
  self~assertSame("good DTLSv1.2", good~result)
  c~close
  srv~close

-- A client accepted whose handshake has not ended: send waits for it too.
::method test_send_waits_for_the_handshake
  srv = newServer()
  msg = .Client~new~start("receiveOnce", srv~localPort)
  c = srv~accept
  c~receiveTimeout = 10
  c~send("first")                            -- the handshake ends here
  self~assertSame("DTLSv1.2", c~protocol)
  self~assertSame("first DTLSv1.2", msg~result)
  c~close
  srv~close

::method test_accept_timeout
  srv = newServer()
  self~assertSame(.nil, srv~acceptTimeout)
  srv~acceptTimeout = 0.3
  self~assertSame(.nil, srv~accept)
  srv~close

::method test_close_ends_an_accept_waiting
  srv = newServer()
  port = srv~localPort
  msg = .Waiter~new~start("accept", srv)
  call sysSleep 0.3
  srv~close
  do 50 while \msg~completed
    call sysSleep 0.1
  end
  self~assertTrue(msg~completed)
  self~assertSame("48.900 TLS error: the DTLS server socket is closed (port" port").", msg~result)

/* ---- the peer goes away ------------------------------------------------- */

::method test_the_server_closes
  srv = newServer()
  msg = .Server~new~start("acceptAndClose", srv)
  s = .DTLSSocket~new("localhost", srv~localPort, trustCA(), 10)
  s~receiveTimeout = 10
  self~assertSame("closed", msg~result)
  self~expectSyntax(.array~of(48.900, "TLS error: the peer closed the connection (localhost, port" srv~localPort")"))
  s~receive

::method test_the_client_closes
  srv = newServer()
  msg = .Client~new~start("connectOnly", srv~localPort)
  c = srv~accept
  c~receiveTimeout = 10
  signal on syntax
  c~receive                                  -- the handshake, then the client's close
  self~fail("receive should have failed")
syntax:
  co = condition("o")
  self~assertSame(48.900, co~code)
  self~assertSame("TLS error: the peer closed the connection (127.0.0.1, port" c~remotePort")", co~additional[1])
  self~assertSame("connected", msg~result)
  srv~close

::method test_receive_timeout
  srv = newServer()
  msg = .Server~new~start("acceptAndWait", srv)
  s = .DTLSSocket~new("localhost", srv~localPort, trustCA(), 10)
  self~assertSame(.nil, s~receiveTimeout)
  s~receiveTimeout = 0.3
  self~assertSame(.nil, s~receive)
  s~send("done")
  self~assertSame("done", msg~result)
  s~close
  srv~close

/* ---- with OpenSSL's own programs (Linux, where they are at hand) -------- */

::method test_openssl_s_client
  if \opensslHere() then return
  srv = newServer()
  msg = .Server~new~start("echoOnceAndClose", srv)
  cmd = "timeout 20 openssl s_client -dtls1_2 -connect 127.0.0.1:"srv~localPort,
        "-CAfile" certFile("ca.pem") "-verify_return_error -quiet"
  input = .array~of("hello from s_client")
  out = .array~new; err = .array~new
  address system cmd with input using (input) output using (out) error using (err)
  self~assertSame("hello from s_client", msg~result~strip("T", "0a"x))
  self~assertTrue(out~makeString("L", " ")~pos("HELLO FROM S_CLIENT") > 0, out~makeString("L", " ") "|" err~makeString("L", " "))
  srv~close

::method test_openssl_s_server
  if \opensslHere() then return
  u = .UDPSocket~new(0, "127.0.0.1"); port = u~localPort; u~close
  -- s_server sends what it reads on its input once a client is there (a
  -- line, two seconds later: the client is there by then), and prints what
  -- it receives; -naccept 1: one client, then it ends
  cmd = "(sleep 2; echo reply from s_server; sleep 3) | timeout 20 openssl s_server -dtls1_2",
        "-accept 127.0.0.1:"port "-cert" certFile("server.pem") "-key" certFile("server.pem") "-naccept 1 -quiet"
  srv = .Shell~new~start("run", cmd)
  s = .nil
  do 5 while s == .nil                       -- until it listens
    call sysSleep 0.5
    s = tryConnect(port)
  end
  if s == .nil then do
    self~fail("s_server did not answer:" srv~result)
    return
  end
  s~receiveTimeout = 10
  s~send("hello s_server" || "0a"x)
  d = s~receive
  self~assertTrue(d~data~pos("reply from s_server") > 0, d~data)
  s~close
  r = srv~result
  self~assertTrue(r~pos("hello s_server") > 0, r)  -- what s_server printed

/* ---- connecting fails ----------------------------------------------------- */

::method test_nobody_answers
  u = .UDPSocket~new(0, "127.0.0.1")         -- reads, never answers
  started = .DateTime~new
  c = connectFails("127.0.0.1", u~localPort, trustCA(), 1)
  self~assertSame(48.900, c~code)
  self~assertSame("TLS error: timed out (127.0.0.1, port" u~localPort")", c~additional[1])
  self~assertTrue((.DateTime~new - started)~totalSeconds < 5)
  u~close

::method test_connection_refused
  u = .UDPSocket~new(0, "127.0.0.1")
  port = u~localPort
  u~close                                    -- nobody there now
  c = connectFails("127.0.0.1", port, trustCA(), 5)
  self~assertSame("TLS error: connection refused (127.0.0.1, port" port")", c~additional[1])
  self~assertSame("SOCKET", c~additional[5])

::method test_the_wrong_host
  srv = .DTLSServerSocket~new(0, serverOptions("wronghost.pem"), "127.0.0.1")
  port = srv~localPort
  .Waiter~new~start("acceptFor", srv, 15)    -- the server, answering
  c = connectFails("localhost", port, trustCA(), 10)
  self~assertTrustError(c, "certificate does not match the host name", "(localhost, port" port")")
  srv~close

::method test_an_expired_certificate
  srv = .DTLSServerSocket~new(0, serverOptions("expired.pem"), "127.0.0.1")
  port = srv~localPort
  .Waiter~new~start("acceptFor", srv, 15)
  c = connectFails("localhost", port, trustCA(), 10)
  self~assertTrustError(c, "certificate has expired", "(localhost, port" port")")
  srv~close

::method test_unknown_host
  c = connectFails("no-such-host.invalid", 4433, trustCA(), 5)
  self~assertSame("TLS error: unknown host (no-such-host.invalid, port 4433)", c~additional[1])
  self~assertSame("SOCKET", c~additional[5])

::method test_dtls_1_3
  opts = trustCA()
  opts~minVersion = "1.3"
  c = connectFails("127.0.0.1", 9, opts, 1)
  -- OpenSSL 3 has no DTLS 1.3 yet
  self~assertTrue(c~additional[1]~startsWith("TLS error: DTLS 1.3 is not supported"), c~additional[1])

/* ---- arguments ------------------------------------------------------------- */

::method test_the_server_needs_a_certificate
  self~expectSyntax(88.900)
  .DTLSServerSocket~new(0, .TLSOptions~new)

::method test_options_must_be_tls_options
  self~expectSyntax(88.900)
  .DTLSSocket~new("localhost", 4433, "options")

::method test_send_after_close
  srv = newServer()
  msg = .Server~new~start("acceptAndWait", srv)
  s = .DTLSSocket~new("localhost", srv~localPort, trustCA(), 10)
  port = srv~localPort
  s~send("done")
  self~assertSame("done", msg~result)
  s~close
  srv~close
  self~expectSyntax(.array~of(48.900, "TLS error: the DTLS socket is closed (localhost, port" port")"))
  s~send("again")



-- A refused certificate's message: ours, then the system's own reason when it
-- says more (additional[4]); then where. additional[5] is "TLS".
::method assertTrustError private
  use arg c, text, where
  sys = c~additional[4]
  self~assertTrue(c~additional[1] == "TLS error:" text where | c~additional[1] == "TLS error:" text":" sys where, -
                  "the message:" c~additional[1])
  self~assertSame("TLS", c~additional[5])

::class Client
::method echoOnce
  use arg port, text, options = (trustCA()), wait = 0
  call sysSleep wait
  s = .DTLSSocket~new("localhost", port, options, 10)
  s~receiveTimeout = 10
  s~send(text)
  reply = s~receive~data s~protocol
  s~close
  return reply
::method receiveOnce
  use arg port, options = (trustCA())
  s = .DTLSSocket~new("localhost", port, options, 10)
  s~receiveTimeout = 10
  reply = s~receive~data s~protocol
  s~close
  return reply
::method connectOnly
  use arg port, options = (trustCA())
  signal on syntax
  s = .DTLSSocket~new("localhost", port, options, 10)
  s~close
  return "connected"
syntax:
  return condition("o")~additional[1]

::class Server
-- Echoes in upper case until "bye"; returns how many it echoed.
::method echoAll
  use arg srv
  c = srv~accept
  c~receiveTimeout = 10
  n = 0
  loop
    d = c~receive
    c~send(d~data~upper)
    n += 1
    if d~data == "bye" then leave
  end
  c~close
  return n
::method echoOnceAndClose
  use arg srv
  c = srv~accept
  c~receiveTimeout = 15
  d = c~receive
  c~send(d~data~upper)
  call sysSleep 0.3
  c~close
  return d~data
::method acceptAndClose
  use arg srv
  c = srv~accept
  c~receiveTimeout = 1
  c~receive                                  -- lets the handshake end (.nil after 1 s)
  c~close
  return "closed"
::method acceptAndWait
  use arg srv
  c = srv~accept
  c~receiveTimeout = 10
  d = c~receive
  c~close
  return d~data

::class Waiter
-- Accepts (answering handshakes) for some seconds; then closes.
::method acceptFor
  use strict arg srv, seconds
  srv~acceptTimeout = seconds
  signal on syntax
  c = srv~accept
  if c \== .nil then c~close
  srv~close
  return
syntax:
  return
::method accept
  use strict arg srv
  signal on syntax
  srv~accept
  return "accepted"
syntax:
  c = condition("o")
  return c~code c~message

::class Shell
::method run
  use arg cmd, line = .nil
  out = .array~new; err = .array~new; in = .array~new
  if line \== .nil then in~append(line)
  address system cmd with input using (in) output using (out) error using (err)
  return rc out~makeString("L", " ") "|" err~makeString("L", " ")

::routine tryConnect
  use arg port
  signal on syntax
  return .DTLSSocket~new("localhost", port, trustCA(), 2)
syntax:
  return .nil

::routine opensslHere
  parse source os .
  if os~upper~pos("LINUX") == 0 then return .false
  address system "openssl version > /dev/null 2>&1"
  return rc == 0

::routine newServer
  return .DTLSServerSocket~new(0, serverOptions("server.pem"), "127.0.0.1")

::routine trustCA
  return .TLSOptions~new~trust(certFile("ca.pem"))

-- The condition object of the SYNTAX condition DTLSSocket~new raised.
::routine connectFails
  use arg host, port, options, timeout = 10
  signal on syntax
  s = .DTLSSocket~new(host, port, options, timeout)
  s~close
  raise syntax 40.900 array("expected DTLSSocket~new to fail; it connected to" host)
syntax:
  return condition("o")
